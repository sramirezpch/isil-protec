{
    "compilerOptions": {
        "target": "ES2022",
        "module": "CommonJS",
        "paths": {
            "bwip-js": ["./node_modules/bwip-js/dist/bwip-js-node.d.ts"]
        },
        "rootDir": "./src",
        "outDir": "./dist",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true
    },
    "include": [
        "src/**/*"
    ]
}