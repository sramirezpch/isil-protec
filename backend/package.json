{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "dotenv -- tsx watch src/server.ts",
    "lint": "biome lint src/",
    "format": "biome format --write src/",
    "check": "biome check --write src/",
    "db:generate": "dotenv -- drizzle-kit generate --config ./src/infrastructure/postgres/db/drizzle.config.ts",
    "db:migrate": "dotenv -- drizzle-kit migrate --config ./src/infrastructure/postgres/db/drizzle.config.ts",
    "db:seed": "dotenv -- tsx src/infrastructure/postgres/db/seed-database.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.13.1",
      "onFail": "download"
    }
  },
  "type": "module",
  "dependencies": {
    "@types/uuid": "^11.0.0",
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "pg": "^8.23.0",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/helmet": "^4.0.0",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "cors": "^2.8.6",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "0.31.11",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
